# Server-side only. Never commit the real key. Set this on Render as an env var.
TINKER_API_KEY=

# Optional: tinker:// path after training. If empty, live mode uses the untuned 4B router.
TINKER_ROUTER_PATH=

# Models (Tinker IDs from https://tinker-docs.thinkingmachines.ai/tinker/models/models_and_pricing/)
ROUTER_MODEL=Qwen/Qwen3.5-4B
BIG_MODEL=Qwen/Qwen3.6-35B-A3B

# Code-side safety. ANSWER below this confidence becomes DEFER.
ANSWER_THRESHOLD=0.72

# Caps
DAILY_SPEND_CAP_USD=2.00
RATE_LIMIT_PER_HOUR=20
MAX_REQUEST_CHARS=2000
CALL_TIMEOUT_SEC=20

# Force replay even if a key is present (useful for screenshots).
FORCE_REPLAY=0
